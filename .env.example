# Copy to .env and fill in. Never commit .env.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram chat IDs allowed to use the bot.
# To find your chat id: send /start to your bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ALLOWED_CHAT_IDS=

# Path to SQLite DB (relative to project root)
DATABASE_URL=sqlite:///data/bibi.db

# Path to YAML strategy config
CONFIG_PATH=config.yaml

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional: Alpaca paper trading (used later, not required for MVP)
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
