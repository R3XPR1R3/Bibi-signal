# Copy to .env and fill in. Never commit .env.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram chat IDs allowed to use the bot.
# To find your chat id: send /start to your bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ALLOWED_CHAT_IDS=

# Path to SQLite DB (relative to project root)
DATABASE_URL=sqlite:///data/bibi.db

# Path to YAML strategy config
CONFIG_PATH=config.yaml

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Alpaca Markets — official, free, real-time STOCK price source.
# Used when price_source: alpaca in config.yaml. Recommended for live data.
# How to get keys:
#   1. https://alpaca.markets/ -> Sign Up (no SSN needed for paper)
#   2. Dashboard -> Paper Trading -> Generate API keys
#   3. Paste them below. Paper-trading keys give you market data on free tier.
# Note: Bibi-Signal does NOT use Alpaca's paper-trading orders — our internal
# paper_engine.py simulates trades against whatever data source you configure.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Robinhood Crypto Trading API — required only if you enable crypto.enabled in config.yaml.
# How to get keys:
#   1. Open Robinhood mobile app -> Account -> Investing -> Crypto Trading API
#   2. Generate an API key. Robinhood gives you the public key + you keep the private key (Ed25519 seed).
#   3. ROBINHOOD_CRYPTO_API_KEY = the api_key string they show
#   4. ROBINHOOD_CRYPTO_PRIVATE_KEY_B64 = base64 of the 32-byte Ed25519 private seed
# Docs: https://docs.robinhood.com/crypto/trading/
ROBINHOOD_CRYPTO_API_KEY=
ROBINHOOD_CRYPTO_PRIVATE_KEY_B64=
ROBINHOOD_CRYPTO_BASE_URL=https://trading.robinhood.com

# Robinhood STOCKS via robin-stocks (UNOFFICIAL — uses Robinhood's internal
# endpoints, ToS gray area). Aggressive polling can get your account locked.
# We mitigate with cache (30s) + local rate limit (30 req/min). For PRICE
# DATA ONLY — never automate trades over this.
#
# Setup:
#   1. pip install -e '.[robinhood]'
#   2. bibi-rh-login                    # interactive, one-time
#   3. set price_source: robinhood in config.yaml
#
# Optional for unattended re-auth: get a TOTP secret (base32) from
# Robinhood when enabling MFA via Authenticator app.
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
ROBINHOOD_MFA_SECRET=
